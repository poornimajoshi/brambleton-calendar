# Google Calendar to write events into (the calendar's ID, e.g. abc123@group.calendar.google.com)
GOOGLE_CALENDAR_ID=

# Service account key. Locally, point to the JSON file:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# In GitHub Actions, paste the full JSON contents into this secret instead:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Optional: LLM parks source. Set PARKS_PROVIDER in config.py to pick one.
# Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
